# ========================================================
# Moodle MCP Server — Configuration (.env)
# ========================================================

# Base URL of your Moodle instance
MOODLE_URL=https://moodle.tau.ac.il

# Option 1 (Recommended): Zero-Token Session Starting (TAU SSO or University SSO)
# The server will log in and establish an authenticated session automatically.
MOODLE_USERNAME=your_sso_username
MOODLE_PASSWORD=your_sso_password
MOODLE_STUDENT_ID=your_id_number

# Option 2: Direct Master Web Service Token (wstoken)
# If provided, the server can use it directly without SSO.
# MOODLE_TOKEN=your_moodle_web_service_token

# Option 3: Browser Session Cookie
# If copying MoodleSession cookie value directly from your browser devtools.
# MOODLE_SESSION_COOKIE=your_session_cookie

# Timezone for formatting deadlines (defaults to Asia/Jerusalem)
TIMEZONE=Asia/Jerusalem

# Panopto URL (for lecture video recordings)
PANOPTO_URL=https://tau.cloud.panopto.eu

# ========================================================
# Multi-User / Multi-Profile Configuration (Single Container)
# ========================================================
# Multiple people can use the server simultaneously in a single container.
# Yuval connects via: https://moodle-mcp.mantin.dev/yuval (or /yuval/mcp)
# Yaeli connects via: https://moodle-mcp.mantin.dev/yaeli (or /yaeli/mcp)
#
# List active profile names (comma-separated):
MOODLE_PROFILES=yuval,yaeli

# Credentials for profile 'yuval':
YUVAL_MOODLE_USERNAME=yuval_sso_username
YUVAL_MOODLE_PASSWORD=yuval_sso_password
YUVAL_MOODLE_STUDENT_ID=yuval_id_number

# Credentials for profile 'yaeli':
YAELI_MOODLE_USERNAME=yaeli_sso_username
YAELI_MOODLE_PASSWORD=yaeli_sso_password
YAELI_MOODLE_STUDENT_ID=yaeli_id_number

# ========================================================
# Google Gemini Integration
# ========================================================
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

